    { "type": "wokwi-text", "id": "heading", "top": -110, "left": 80, "attrs": { "text": "MONTAGEM: ESP32 + HC-SR04 + L298N + 2 MOTORES DC\nNumeros = GPIOs. Siga as inscricoes da sua placa." } },
    { "type": "wokwi-text", "id": "dividerLabel", "top": 170, "left": 440, "attrs": { "text": "ECHO: 2 x 330 ohms ate GPIO22\n3 x 330 ohms desse ponto ate GND\nNa montagem real: 5V -> ~3V" } },
